---
import BaseLayout from "../layouts/BaseLayout.astro";

const socialLinks = [
  { label: "Instagram", href: "https://instagram.com/" }, // TODO: 実際のSNSアカウントURLに差し替える
  { label: "X (Twitter)", href: "https://x.com/" }, // TODO: 実際のSNSアカウントURLに差し替える
];
---

<BaseLayout title="お問い合わせ">
  <section class="mx-auto max-w-2xl px-4 py-20 md:py-40">
    <h1 class="fade-up text-center">お問い合わせ</h1>
    <p class="fade-up prose-body mx-auto mt-6 text-center text-[var(--color-text-muted)]" data-delay="80">
      準備中のダミーテキストです。ご質問やオーダーメイドのご相談など、お気軽にお問い合わせください。
    </p>

    <!--
      TODO: 送信先メールアドレス未確定。
      Netlifyの管理画面（Site settings > Forms > Form notifications）で
      通知先メールアドレスを設定すること。
    -->
    <form
      name="contact"
      method="POST"
      data-netlify="true"
      netlify-honeypot="bot-field"
      class="fade-up mt-16 flex flex-col gap-6"
      data-delay="160"
    >
      <input type="hidden" name="form-name" value="contact" />
      <p class="hidden">
        <label>
          入力しないでください
          <input name="bot-field" />
        </label>
      </p>

      <div class="flex flex-col gap-2">
        <label for="name" class="text-sm">お名前</label>
        <input
          id="name"
          name="name"
          type="text"
          required
          class="border border-[var(--color-border)] bg-white px-4 py-3 text-sm focus:border-[var(--color-accent-sage)] focus:outline-none"
        />
      </div>

      <div class="flex flex-col gap-2">
        <label for="email" class="text-sm">メールアドレス</label>
        <input
          id="email"
          name="email"
          type="email"
          required
          class="border border-[var(--color-border)] bg-white px-4 py-3 text-sm focus:border-[var(--color-accent-sage)] focus:outline-none"
        />
      </div>

      <div class="flex flex-col gap-2">
        <label for="message" class="text-sm">お問い合わせ内容</label>
        <textarea
          id="message"
          name="message"
          rows="6"
          required
          class="border border-[var(--color-border)] bg-white px-4 py-3 text-sm focus:border-[var(--color-accent-sage)] focus:outline-none"
        ></textarea>
      </div>

      <label class="flex items-start gap-2 text-sm text-[var(--color-text-muted)]">
        <input type="checkbox" required class="mt-1" />
        <span>
          <a href="/privacy" class="underline underline-offset-4">プライバシーポリシー</a>に同意する
        </span>
      </label>

      <button
        type="submit"
        class="mt-4 border border-[var(--color-text)] px-8 py-3 text-sm transition-colors hover:bg-[var(--color-text)] hover:text-[var(--color-bg)]"
      >
        送信する
      </button>
    </form>

    <div class="fade-up mt-20 border-t border-[var(--color-border)] pt-12 text-center" data-delay="240">
      <h2>SNS</h2>
      <div class="mt-6 flex justify-center gap-6">
        {
          socialLinks.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm text-[var(--color-text-muted)] transition-colors hover:text-[var(--color-text)]"
            >
              {link.label}
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
