---
const navItems = [
  { href: "/", label: "トップ" },
  { href: "/about", label: "プロフィール" },
  { href: "/candles", label: "キャンドル" },
  { href: "/events", label: "イベント" },
  { href: "/gallery", label: "ギャラリー" },
  { href: "/contact", label: "お問い合わせ" },
];
---

<header class="sticky top-0 z-50 border-b border-[var(--color-border)] bg-[var(--color-bg)]/95 backdrop-blur">
  <div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-4 md:px-8">
    <a href="/" class="font-[family-name:var(--font-heading)] text-lg tracking-wide">
      [ブランド名]
    </a>

    <nav class="hidden gap-8 md:flex">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="text-sm text-[var(--color-text-muted)] transition-colors hover:text-[var(--color-text)]"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <button
      id="menu-toggle"
      type="button"
      aria-label="メニューを開く"
      aria-expanded="false"
      aria-controls="mobile-menu"
      class="flex h-10 w-10 flex-col items-center justify-center gap-1.5 md:hidden"
    >
      <span class="h-px w-6 bg-[var(--color-text)] transition-transform" data-menu-line="1"></span>
      <span class="h-px w-6 bg-[var(--color-text)] transition-opacity" data-menu-line="2"></span>
      <span class="h-px w-6 bg-[var(--color-text)] transition-transform" data-menu-line="3"></span>
    </button>
  </div>

  <nav
    id="mobile-menu"
    class="fixed inset-0 z-40 hidden flex-col items-center justify-center gap-8 bg-[var(--color-bg)] md:hidden"
  >
    {
      navItems.map((item) => (
        <a
          href={item.href}
          class="font-[family-name:var(--font-heading)] text-2xl text-[var(--color-text)]"
        >
          {item.label}
        </a>
      ))
    }
  </nav>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");

  toggle?.addEventListener("click", () => {
    const isOpen = menu?.classList.contains("flex");
    menu?.classList.toggle("hidden", isOpen);
    menu?.classList.toggle("flex", !isOpen);
    toggle.setAttribute("aria-expanded", String(!isOpen));
    document.body.classList.toggle("overflow-hidden", !isOpen);
  });

  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      menu.classList.add("hidden");
      menu.classList.remove("flex");
      toggle?.setAttribute("aria-expanded", "false");
      document.body.classList.remove("overflow-hidden");
    });
  });
</script>
