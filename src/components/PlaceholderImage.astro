---
interface Props {
  label?: string;
  ratio?: string;
  class?: string;
}

const { label = "画像準備中", ratio = "aspect-[4/3]", class: className = "" } = Astro.props;
---

<div
  class:list={[
    "flex items-center justify-center border border-dashed border-[var(--color-border)] bg-[var(--color-surface)] text-sm text-[var(--color-text-muted)]",
    ratio,
    className,
  ]}
>
  {label}
</div>
