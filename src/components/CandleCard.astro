---
import PlaceholderImage from "./PlaceholderImage.astro";

interface Props {
  name: string;
  scent: string;
  description: string;
  price: number;
  delay?: number;
}

const { name, scent, description, price, delay = 0 } = Astro.props;
---

<article class="fade-up" data-delay={delay}>
  <PlaceholderImage label={`${name} 画像準備中`} />
  <div class="mt-4">
    <h3>{name}</h3>
    <p class="mt-1 text-sm text-[var(--color-accent-sage)]">{scent}</p>
    <p class="mt-2 text-sm text-[var(--color-text-muted)]">{description}</p>
    <p class="mt-3 text-sm">&yen;{price.toLocaleString()}</p>
  </div>
</article>
