<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title or site.site.meta.title }}</title>
<meta name="description" content="{{ description or site.site.meta.description }}">
<link rel="icon" href="/favicon.svg">
<meta property="og:type" content="website">
<meta property="og:title" content="{{ title or site.site.meta.title }}">
<meta property="og:description" content="{{ description or site.site.meta.description }}">
<meta property="og:image" content="{{ site.site.baseUrl }}/assets/{{ (site.assets | findAsset(site.site.meta.ogImage)).file }}">
<meta property="og:url" content="{{ site.site.baseUrl }}{{ ogPath }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Zen+Old+Mincho:wght@400;500;600&amp;family=Noto+Sans+JP:wght@300;400;500&amp;display=swap">
<link rel="stylesheet" href="style.css">
</head>
<body>
<header class="site-header">
  <div class="site-header__inner">
    <a class="site-header__brand" href="/#top">teate<span class="site-header__brand-accent">1122</span></a>
    <nav class="site-header__nav" aria-label="サイト内ナビゲーション">
      {% for item in site.nav.items | selectattr("visible") %}<a href="{{ item.href }}"{% if loop.last %} class="site-header__nav-cta"{% endif %}>{{ item.label }}</a>
{% endfor %}    </nav>
    <button type="button" class="site-header__menu-btn" aria-haspopup="dialog" aria-controls="mobile-menu" onclick="document.getElementById('mobile-menu').showModal()" aria-label="メニューを開く">
      <span></span><span></span>
    </button>
  </div>
</header>

<dialog id="mobile-menu" class="mobile-menu">
  <button type="button" class="mobile-menu__close" onclick="this.closest('dialog').close()" aria-label="メニューを閉じる">&times;</button>
  <nav class="mobile-menu__nav" aria-label="モバイルナビゲーション">
    {% for item in site.nav.items | selectattr("visible") %}<a href="{{ item.href }}" onclick="document.getElementById('mobile-menu').close()"{% if loop.last %} class="mobile-menu__cta"{% endif %}>{{ item.label }}</a>
{% endfor %}  </nav>
</dialog>

<main id="top">
{{ content | safe }}
</main>

<footer class="site-footer">
  <div class="site-footer__inner">
    <div>
      <p class="site-footer__brand">teate<span class="site-header__brand-accent">1122</span></p>
      <p class="site-footer__tagline">手当てのような灯りを、ひとつずつ。</p>
    </div>
    <div class="site-footer__links">
      {% for s in site.social %}<a href="{{ s.url }}" target="_blank" rel="noopener noreferrer" class="site-footer__social-link">{{ s.platform | capitalize }} {{ s.handle }}</a>
{% endfor %}      <a href="/privacy.html">プライバシーポリシー</a>
      <p class="site-footer__copyright">&copy; 2026 teate1122</p>
    </div>
  </div>
</footer>

<nav class="mobile-tabs" aria-label="モバイルナビゲーション">
  <a href="/#candles" class="mobile-tabs__item">
    <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"></path></svg>
    キャンドル
  </a>
  <a href="/#events" class="mobile-tabs__item">
    <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2v4"></path><path d="M16 2v4"></path><path d="M3 10h18"></path><path d="M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z"></path></svg>
    イベント
  </a>
  <a href="/#gallery" class="mobile-tabs__item">
    <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round"><path d="M18 22H4a2 2 0 0 1-2-2V6"></path><path d="m22 13-1.3-1.3a2 2 0 0 0-2.8 0L14 15"></path><circle cx="12" cy="8" r="2"></circle><rect width="16" height="16" x="6" y="2" rx="2"></rect></svg>
    ギャラリー
  </a>
  <a href="/#contact" class="mobile-tabs__item mobile-tabs__item--accent">
    <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
    お問い合わせ
  </a>
</nav>

<script src="site.js" defer></script>
</body>
</html>
